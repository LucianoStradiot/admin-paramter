<core:FragmentDefinition xmlns="sap.m"
	xmlns:core="sap.ui.core">
	<ViewSettingsDialog confirm="handleFilterDialogConfirm" resetFilters="onResetFilter">
		<filterItems>	
			<ViewSettingsFilterItem text="{i18n>KEY_VIEW}" key="KEY_VIEW" multiSelect="false" items="{oModelFilter0>/}">
				<items>
					<ViewSettingsItem text="{oModelFilter0>key}" key="{oModelFilter0>key}"/>
				</items>
			</ViewSettingsFilterItem>
            <ViewSettingsFilterItem text="{i18n>VALUE_VIEW}" key="VALUE_VIEW" multiSelect="false" items="{oModelFilter1>/}">
				<items>
					<ViewSettingsItem text="{oModelFilter1>key}" key="{oModelFilter1>key}"/>
				</items>
			</ViewSettingsFilterItem>
            <ViewSettingsFilterItem text="{i18n>DESCRIPTION}" key="DESCRIPTION" multiSelect="false" items="{oModelFilter2>/}">
				<items>
					<ViewSettingsItem text="{oModelFilter2>key}" key="{oModelFilter2>key}"/>
				</items>
			</ViewSettingsFilterItem>
						
		</filterItems>
	</ViewSettingsDialog>
</core:FragmentDefinition>	